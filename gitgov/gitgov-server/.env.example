# ============================================================
# GitGov Control Plane Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and ignored.
# ============================================================

# ---- Required -----------------------------------------------

# PostgreSQL connection string (Supabase pooler or local)
DATABASE_URL=postgresql://user:password@host:5432/gitgov

# JWT signing secret — REQUIRED in production.
# Generate with: openssl rand -hex 32
GITGOV_JWT_SECRET=

# API key for desktop clients. Inserted into DB on startup if missing.
GITGOV_API_KEY=your-api-key-here

# ---- Runtime Environment ------------------------------------

# "dev" | "development" | "local" | "test" | "staging" | "prod" (default: "prod")
# In dev/test mode: optional insecure JWT fallback can be enabled explicitly.
# GITGOV_ENV=dev

# Server bind address (default: 0.0.0.0:3000)
# GITGOV_SERVER_ADDR=0.0.0.0:3000

# ---- Supabase (if using Supabase as DB) ---------------------

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_KEY=eyJ...

# ---- GitHub Integration -------------------------------------

# HMAC secret for validating GitHub webhooks
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Personal access token for GitHub API calls (MCP, PR checks)
# GITHUB_PERSONAL_ACCESS_TOKEN=<your-github-token>

# ---- OPA/Rego Adapter (optional) -----------------------------

# External OPA server URL. Use HTTPS for remote OPA, or localhost for sidecar/dev.
# Policy files may omit adapters.opa.base_url and rely on this env value.
# GITGOV_OPA_URL=http://127.0.0.1:8181

# Optional bearer token value. Policy files reference only the env var name:
# adapters.opa.token_env_var = "OPA_AUTH_TOKEN"
# OPA_AUTH_TOKEN=<your-opa-token>

# ---- Jenkins Integration (optional) -------------------------

# Webhook secret for Jenkins (header: x-gitgov-jenkins-secret)
# If unset, any authenticated admin request is accepted.
# JENKINS_WEBHOOK_SECRET=

# ---- Jira Integration (optional) ----------------------------

# Webhook secret for Jira (header: x-gitgov-jira-secret)
# If unset, any authenticated admin request is accepted.
# JIRA_WEBHOOK_SECRET=

# ---- TLS / HTTPS ---------------------------------------------

# Path to PEM-encoded TLS certificate (fullchain).
# If both GITGOV_TLS_CERT and GITGOV_TLS_KEY are set, server starts in HTTPS mode.
# If only one is set, server exits with an error.
# If neither is set, server starts in plain HTTP (use reverse proxy for TLS in prod).
# GITGOV_TLS_CERT=/etc/letsencrypt/live/yourdomain/fullchain.pem

# Path to PEM-encoded TLS private key.
# GITGOV_TLS_KEY=/etc/letsencrypt/live/yourdomain/privkey.pem

# ---- CORS ---------------------------------------------------

# Allow any origin (default: true in dev, false in prod)
# GITGOV_CORS_ALLOW_ANY=false

# Comma-separated list of allowed origins (required in prod if CORS_ALLOW_ANY=false)
# GITGOV_CORS_ALLOW_ORIGINS=http://127.0.0.1:1420,tauri://localhost

# ---- Security Hardening -------------------------------------

# Allow insecure JWT fallback ONLY when GITGOV_ENV is dev/local/test.
# Default is false in all environments; enable only for local troubleshooting.
# GITGOV_ALLOW_INSECURE_JWT_FALLBACK=true

# Require actor login to match exactly (default: true)
# GITGOV_STRICT_ACTOR_MATCH=true

# Reject synthetic logins like "unknown" (default: false)
# GITGOV_REJECT_SYNTHETIC_LOGINS=false

# ---- Bot / Chat (Gemini AI) ---------------------------------

# Gemini API key for conversational bot
# GEMINI_API_KEY=<your-gemini-api-key>

# Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Max concurrent LLM requests (default: 16)
# GITGOV_CHAT_LLM_MAX_CONCURRENCY=16

# Queue timeout in ms (default: 3000)
# GITGOV_CHAT_LLM_QUEUE_TIMEOUT_MS=3000

# Request timeout in ms (default: 9000)
# GITGOV_CHAT_LLM_TIMEOUT_MS=9000

# ---- Capacity Profile (250 concurrent users, medium budget) --
# Uncomment and tune in production rollout:
# GITGOV_DB_MAX_CONNECTIONS=30
# GITGOV_DB_MIN_CONNECTIONS=6
# GITGOV_DB_ACQUIRE_TIMEOUT_SECS=12
# GITGOV_RATE_LIMIT_EVENTS_PER_MIN=1500
# GITGOV_RATE_LIMIT_ADMIN_PER_MIN=240
# GITGOV_RATE_LIMIT_LOGS_PER_MIN=900
# GITGOV_RATE_LIMIT_STATS_PER_MIN=900
# GITGOV_RATE_LIMIT_CHAT_PER_MIN=180
# GITGOV_CHAT_LLM_MAX_CONCURRENCY=8
# GITGOV_CHAT_LLM_QUEUE_TIMEOUT_MS=1200
# GITGOV_CHAT_LLM_TIMEOUT_MS=12000
# GITGOV_SSE_MAX_CONNECTIONS=120
# GITGOV_RATE_LIMIT_DISTRIBUTED_DB=true
# GITGOV_RATE_LIMIT_DISTRIBUTED_PRUNE_INTERVAL_SECS=60
# GITGOV_RATE_LIMIT_DISTRIBUTED_RETENTION_SECS=3600
# GITGOV_OUTBOX_SERVER_LEASE_ENABLED=true
# GITGOV_OUTBOX_SERVER_LEASE_TTL_MS=2000

# ---- Rate Limiting ------------------------------------------

# Events ingestion (default: 240/min)
# GITGOV_RATE_LIMIT_EVENTS_PER_MIN=240

# Audit stream ingestion (default: 60/min)
# GITGOV_RATE_LIMIT_AUDIT_STREAM_PER_MIN=60

# Jenkins ingestion (default: 120/min)
# GITGOV_RATE_LIMIT_JENKINS_PER_MIN=120

# Jira ingestion (default: 120/min)
# GITGOV_RATE_LIMIT_JIRA_PER_MIN=120

# GitHub webhook public endpoint (default: 240/min)
# GITGOV_RATE_LIMIT_GITHUB_WEBHOOK_PER_MIN=240

# Public organization invitation endpoints (default: 90/min)
# GITGOV_RATE_LIMIT_ORG_INVITATION_PER_MIN=90

# Admin endpoints: logs, stats, dashboard (default: 60/min)
# GITGOV_RATE_LIMIT_ADMIN_PER_MIN=60

# Logs endpoint override (default: same as admin)
# GITGOV_RATE_LIMIT_LOGS_PER_MIN=60

# Stats endpoint override (default: same as admin)
# GITGOV_RATE_LIMIT_STATS_PER_MIN=60

# Chat endpoint (default: 40/min)
# GITGOV_RATE_LIMIT_CHAT_PER_MIN=40

# Use DB-backed distributed rate limiting (default: false)
# GITGOV_RATE_LIMIT_DISTRIBUTED_DB=false

# Distributed rate limit prune interval in secs (default: 300, min: 30)
# GITGOV_RATE_LIMIT_DISTRIBUTED_PRUNE_INTERVAL_SECS=300

# Distributed rate limit retention in secs (default: 3600, min: 120)
# GITGOV_RATE_LIMIT_DISTRIBUTED_RETENTION_SECS=3600

# ---- Body Size Limits ---------------------------------------

# Max body for /events POST (default: 2 MB)
# GITGOV_EVENTS_MAX_BODY_BYTES=2097152

# Max body for Jenkins webhook (default: 256 KB)
# GITGOV_JENKINS_MAX_BODY_BYTES=262144

# Max body for Jira webhook (default: 512 KB)
# GITGOV_JIRA_MAX_BODY_BYTES=524288

# Max events per batch in /events (default: 1000)
# GITGOV_EVENTS_MAX_BATCH=1000

# ---- Caching ------------------------------------------------

# Stats cache TTL in ms (default: 3000)
# GITGOV_STATS_CACHE_TTL_MS=3000

# Logs cache TTL in ms (default: 800)
# GITGOV_LOGS_CACHE_TTL_MS=800

# Logs cache stale-on-error TTL in ms (default: 5000)
# GITGOV_LOGS_CACHE_STALE_ON_ERROR_MS=5000

# Org login -> org_id lookup cache TTL in ms for /events (default: 30000)
# GITGOV_ORG_LOOKUP_CACHE_TTL_MS=30000

# Repo full_name -> repo lookup cache TTL in ms for /events (default: 30000)
# GITGOV_REPO_LOOKUP_CACHE_TTL_MS=30000

# Minimum interval for background repo upsert attempts per org/repo in /events (default: 30000)
# GITGOV_REPO_UPSERT_MIN_INTERVAL_MS=30000

# Minimum interval between cache invalidations under heavy ingest (default: 120)
# GITGOV_CACHE_INVALIDATION_MIN_INTERVAL_MS=120

# Stats cache invalidation debounce in ms (default: GITGOV_CACHE_INVALIDATION_MIN_INTERVAL_MS)
# GITGOV_STATS_CACHE_INVALIDATION_MIN_INTERVAL_MS=120

# Logs cache invalidation debounce in ms (default: GITGOV_CACHE_INVALIDATION_MIN_INTERVAL_MS)
# GITGOV_LOGS_CACHE_INVALIDATION_MIN_INTERVAL_MS=120

# Reject legacy offset pagination on /logs (default: false)
# GITGOV_LOGS_REJECT_OFFSET_PAGINATION=false

# ---- SSE (Server-Sent Events) -------------------------------

# Max concurrent SSE connections (default: 50)
# GITGOV_SSE_MAX_CONNECTIONS=50

# Enable cross-instance SSE fan-out using PostgreSQL NOTIFY (default: false)
# GITGOV_SSE_DISTRIBUTED_ENABLED=false

# Postgres channel for distributed SSE fan-out (default: gitgov_sse_events)
# GITGOV_SSE_DISTRIBUTED_CHANNEL=gitgov_sse_events

# ---- Outbox / Lease -----------------------------------------

# Enable server-driven outbox lease coordination (default: false)
# GITGOV_OUTBOX_SERVER_LEASE_ENABLED=false

# Outbox lease TTL in ms (default: 2000, range: 1000-60000)
# GITGOV_OUTBOX_SERVER_LEASE_TTL_MS=2000

# Minimum interval between client_sessions upserts per client in /events (default: 15000)
# GITGOV_CLIENT_SESSION_UPSERT_MIN_INTERVAL_MS=15000

# ---- Data Retention ------------------------------------------

# Audit data retention in days (min: 1825 = 5 years, compliance)
# AUDIT_RETENTION_DAYS=1825

# Client session retention in days (default: 365)
# CLIENT_SESSION_RETENTION_DAYS=365

# Legacy fallback for client session retention
# DATA_RETENTION_DAYS=365

# ---- Alerting / Webhooks ------------------------------------

# Webhook URL for critical alerts (Slack, Discord, etc.)
# GITGOV_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Dedicated webhook targets for critical policy drift alerts (comma-separated).
# If set, these targets are used instead of GITGOV_ALERT_WEBHOOK_URL for drift alerts.
# Supports Slack / Teams / email-gateway webhooks.
# GITGOV_DRIFT_ALERT_WEBHOOK_URLS=https://hooks.slack.com/services/aaa,https://outlook.office.com/webhook/bbb
# Legacy single-target alias (optional): GITGOV_DRIFT_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/aaa

# Webhook URL for feature requests from bot
# FEATURE_REQUEST_WEBHOOK_URL=https://hooks.slack.com/services/...

# ---- Logging -------------------------------------------------

# Rust tracing filter (default: gitgov_server=info,tower_http=info)
# RUST_LOG=gitgov_server=debug,tower_http=debug
