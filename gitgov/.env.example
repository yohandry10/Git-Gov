# ============================================================
# GitGov Desktop App — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Vite (Frontend React) ----------------------------------

# Control Plane server URL (used by the React frontend)
VITE_SERVER_URL=http://127.0.0.1:3000

# API key for authenticating with the Control Plane
VITE_API_KEY=your-api-key-here

# Force device flow auth on startup (default: true)
# VITE_REQUIRE_DEVICE_FLOW_ON_START=true

# Platform founder authentication uses GITGOV_API_KEY on the backend, not GitHub login.

# Legacy API key fallback (leave empty to disable)
# VITE_LEGACY_DEFAULT_API_KEY=
# VITE_ALLOW_LEGACY_DEFAULT_API_KEY=false

# ---- Tauri (Rust Backend) -----------------------------------
# These are read by src-tauri/src/lib.rs at startup.

# Control Plane server URL (used by the Tauri backend)
# Defaults to http://127.0.0.1:3000 if not set.
# GITGOV_SERVER_URL=http://127.0.0.1:3000

# API key for the Tauri backend to authenticate with the server
# GITGOV_API_KEY=your-api-key-here

# GitHub OAuth App client ID for Device Flow login in Desktop
# GITHUB_CLIENT_ID=your-github-oauth-client-id

# CLI hardening flags.
# Native terminal is enabled by default in Desktop; set false only to opt out of the
# interactive shell surface in a restricted runtime.
# GITGOV_ENABLE_SHELL_COMMANDS=true
# GITGOV_ENABLE_NATIVE_TERMINAL=true

# ---- Outbox Coordination (desktop runtime, no UI changes) ----
# Keep desktop event flush bursts controlled under high concurrency.
# GITGOV_OUTBOX_GLOBAL_COORD_ENABLED=true
# GITGOV_OUTBOX_GLOBAL_COORD_WINDOW_MS=20000
# GITGOV_OUTBOX_GLOBAL_COORD_MAX_DEFERRAL_MS=1600
# GITGOV_OUTBOX_SERVER_LEASE_ENABLED=true
# GITGOV_OUTBOX_SERVER_LEASE_TTL_MS=2000
# GITGOV_OUTBOX_FLUSH_JITTER_MAX_MS=5000
